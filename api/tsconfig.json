{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": [
            "vite/client"
        ],
        "paths": {
            "@gtrack/types": [
                "../packages/types/src/index.ts"
            ],
            "@gtrack/design": [
                "../packages/design/src/index.ts"
            ]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "../packages/types/src/**/*.ts",
        "../packages/design/src/**/*.ts"
    ]
}
